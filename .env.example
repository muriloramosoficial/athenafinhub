# ---------------------------------------------------------------------------
# Athena FinHub - variáveis de ambiente
# Desenvolvimento local: copie para .env.local
# Produção (Cloudflare): configure no painel. Ver docs/PUBLICAR.md (etapa 4).
#   - NEXT_PUBLIC_* : são "Build variables" (usadas na hora do build)
#   - APP_ALLOWED_HOSTS : "Variable" de runtime (lida pelo middleware)
# ---------------------------------------------------------------------------

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon / publishable). Pode ir ao navegador: a segurança vem do RLS.
# NUNCA coloque a service_role/secret key neste projeto.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica-aqui

# Domínio(s) da intranet, separados por vírgula. Qualquer outro Host recebe 403.
# Produção: intranet.suaempresa.com.br
# Em produção, se estiver vazio, o sistema bloqueia tudo (falha fechado).
APP_ALLOWED_HOSTS=localhost:3000
