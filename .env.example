# ---------------------------------------------------------------------------
# Athena FinHub - variáveis de ambiente
# Copie este arquivo para .env.local (desenvolvimento) ou configure no Vercel.
# ---------------------------------------------------------------------------

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon / publishable). Pode ficar no navegador: a segurança
# vem do RLS. NUNCA coloque a service_role key neste projeto.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica-aqui

# Domínios permitidos (separados por vírgula). Qualquer outro Host recebe 403.
# Ex.: intranet.suaempresa.com.br
# Deixe vazio apenas em desenvolvimento local.
APP_ALLOWED_HOSTS=
